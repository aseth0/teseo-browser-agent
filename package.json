{
  "name": "teseo-browser-agent",
  "private": true,
  "version": "0.76.0",
  "description": "An AI assistant that lives in your browser, reads the page you are on and acts on it, with your permission: any OpenAI-compatible provider, MCP and skills.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aseth0/teseo-browser-agent.git"
  },
  "homepage": "https://github.com/aseth0/teseo-browser-agent#readme",
  "bugs": {
    "url": "https://github.com/aseth0/teseo-browser-agent/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "zip:store": "STORE=1 wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "e2e": "wxt build && node tests/e2e/sidepanel.e2e.mjs",
    "lint": "eslint src --max-warnings 0",
    "security": "sh scripts/security.sh"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@joplin/turndown-plugin-gfm": "1.0.68",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mozilla/readability": "0.6.0",
    "decode-named-character-reference": "1.3.0",
    "highlight.js": "11.12.0",
    "liquidjs": "10.30.1",
    "lowlight": "3.3.0",
    "lucide": "1.70.0",
    "pdfjs-dist": "6.5.438",
    "pele": "1.13.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "turndown": "7.2.5",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "5.0.6",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "playwright-core": "1.65.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  },
  "license": "Apache-2.0"
}
